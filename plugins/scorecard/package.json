{
  "name": "@internal/plugin-scorecard",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Entity card that shows the Marlow production-readiness scorecard.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "scorecard",
    "pluginPackages": [
      "@internal/plugin-scorecard",
      "@internal/plugin-scorecard-backend",
      "@internal/plugin-scorecard-common"
    ]
  },
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.10.2",
    "@backstage/core-components": "^0.18.15",
    "@backstage/frontend-plugin-api": "^0.18.2",
    "@backstage/plugin-catalog-react": "^3.3.0",
    "@internal/plugin-scorecard-common": "workspace:^",
    "@material-ui/core": "^4.12.2",
    "@material-ui/icons": "^4.9.1"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/theme": "^0.7.3",
    "@testing-library/react": "^14.0.0",
    "@types/react": "^18",
    "react": "^18.0.2",
    "react-dom": "^18.0.2"
  },
  "files": [
    "dist"
  ]
}
