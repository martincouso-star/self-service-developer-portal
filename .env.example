# GitHub integration used by the catalog and by software templates.
# Leave this empty to browse the portal and dry-run templates.
# A classic PAT or fine-grained token with repository access is required only
# when a template runs the publish:github step.
# https://backstage.io/docs/integrations/github/locations
GITHUB_TOKEN=

# Optional. Directory for local SQLite files, relative to packages/backend
# when unset. The default is the repository-root .local-data directory.
# SQLITE_DIR=../../.local-data

# Used only by app-config.production.yaml. Local `yarn start` does not need them.
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_USER=
# POSTGRES_PASSWORD=
